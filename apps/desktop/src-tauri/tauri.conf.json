{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assisstant Desktop",
  "version": "0.1.0",
  "identifier": "com.voduong.assisstantdesktop",
  "build": {
    "beforeDevCommand": "pnpm sidecar:stage:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar:stage:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Assisstant Desktop",
        "width": 620,
        "height": 760,
        "minWidth": 440,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/assistant-mcp",
      "binaries/assistant"
    ],
    "shortDescription": "Windows AI assistant powered by Antigravity and MCP"
  }
}
